# Ambiente: dev | stage | prod (elige el bloque de config/environments.json)
environment=prod

# true = solo registra lo que enviaría; no publica en RabbitMQ ni marca como leídas
DRY_RUN=true

# Secretos. Si no se definen aquí, se leen de /run/secrets/<nombre en minúsculas>
TOKEN_KEY=
MZONE_SECRET=
RABBITMQ_USER=
RABBITMQ_PASSW=

# Cualquier valor de config/environments.json se puede sobrescribir por variable, p. ej.:
# API_URL=http://10.0.4.188:8080
# RABBITMQ_HOST=10.0.4.100
